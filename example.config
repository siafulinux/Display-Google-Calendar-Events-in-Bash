```bash
# ==============================================================================
# Google Calendar CLI Configuration
# ==============================================================================
#
# Copy this file to "config" and enter your actual credentials:
#
#     cp example.config config
#
# Then edit:
#
#     nano config
#
# The actual "config" file should NEVER be committed to Git.
# ==============================================================================

# Google Calendar API key
GOOGLE_API_KEY="your-google-api-key-here"

# Google Calendar ID
#
# Examples:
#
#   Primary calendar:
#   your-email@gmail.com
#
#   Shared calendar:
#   abc123456789@group.calendar.google.com
#
CALENDAR_ID="your-calendar-id-here"
```
